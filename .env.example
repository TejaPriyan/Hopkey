# TURN is optional and is never hardcoded. Without it Mode A uses STUN only
# (works on most home/mobile networks, may fail on strict corporate networks / VPNs).
VITE_TURN_URL=
VITE_TURN_USER=
VITE_TURN_PASS=

# Optional: your own PeerJS signalling server (see README). Empty = PeerJS public cloud (0.peerjs.com).
VITE_PEER_HOST=
VITE_PEER_PORT=
VITE_PEER_PATH=
VITE_PEER_SECURE=

# Optional: set to 1 to make join links use #/r/CODE (for hosts without SPA fallback, e.g. GitHub Pages).
VITE_HASH_ROUTES=
